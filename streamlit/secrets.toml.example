# ============================================================
#  Ejemplo de configuración de secretos para Fintech Quant Lab
#
#  Copia este archivo como `.streamlit/secrets.toml` y rellena los
#  valores reales. NO lo subas a git — `.gitignore` ya lo excluye.
# ============================================================

# Canales activos separados por coma (console, file, email, telegram, slack)
FQL_ALERT_CHANNELS = "console,file"

# Archivo de log local
FQL_ALERT_LOG = "data/alerts.log"

# ------------------------------------------------------------
#  Email (SMTP)
# ------------------------------------------------------------
# Gmail: usa una App Password, no tu contraseña de cuenta.
# Actívala en: https://myaccount.google.com/apppasswords
FQL_SMTP_HOST = "smtp.gmail.com"
FQL_SMTP_PORT = "587"
FQL_SMTP_USER = "tu_correo@gmail.com"
FQL_SMTP_PASS = "tu_app_password"
FQL_SMTP_TLS = "true"
FQL_EMAIL_FROM = "tu_correo@gmail.com"
FQL_EMAIL_TO = "destino1@gmail.com,destino2@gmail.com"

# ------------------------------------------------------------
#  Telegram
# ------------------------------------------------------------
# 1. Habla con @BotFather en Telegram → /newbot
# 2. Copia el token
# 3. Visita https://api.telegram.org/bot<TOKEN>/getUpdates para el chat_id
FQL_TELEGRAM_TOKEN = "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
FQL_TELEGRAM_CHAT_ID = "123456789"

# ------------------------------------------------------------
#  Slack
# ------------------------------------------------------------
# Crea un Incoming Webhook en: https://api.slack.com/messaging/webhooks
FQL_SLACK_WEBHOOK = "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX"
